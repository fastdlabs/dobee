{
    "name": "fastd/dobee",
    "description": "Minimal FastD application skeleton with Swoole and FastCGI runtimes.",
    "type": "project",
    "license": "MIT",
    "prefer-stable": true,
    "keywords": [
        "FastD"
    ],
    "authors": [
        {
            "name": "JanHuang",
            "email": "bboyjanhuang@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "": "src/"
        }
    },
    "require": {
        "php": ">=8.4.1",
        "ext-json": "*",
        "fastd/fastd": "^8.3",
        "fastd/cache": "^8.1",
        "fastd/medoodb": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/console": "^8.0",
        "swoole/ide-helper": "^6.0",
        "phpstan/phpstan": "^2.3",
        "fastd/dobee-demo": "^1.4.3"
    },
    "config": {
        "bin-dir": "bin"
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"is_file('vendor/fastd/dobee-demo/scripts/install.php') && require 'vendor/fastd/dobee-demo/scripts/install.php';\""
        ],
        "post-update-cmd": [
            "@php -r \"is_file('vendor/fastd/dobee-demo/scripts/install.php') && require 'vendor/fastd/dobee-demo/scripts/install.php';\""
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/fastdlabs/dobee-demo.git"
        }
    ]
}
